						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nama\": \"Owner Demo\",\n  \"email\": \"owner@demo.com\",\n  \"telepon\": \"081234567890\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"alamat\": \"Jl. Contoh No. 1\"\n}"
