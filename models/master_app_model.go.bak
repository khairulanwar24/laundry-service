package models

import (
	"fmt"
	"sso-service/database"
	"sso-service/types"
	"strings"
)

func GetMasterApps(limitParam, offsetParam int, order, filter string) types.Response {
	var resp types.Response

	// Membentuk query SQL dasar untuk mengambil data dari master_aplikasi
	sTable := `SELECT
							id_master_aplikasi,
							nama_aplikasi,
							deskripsi,
							versi_aplikasi,
							status_data,
							tgl_version,
							url,
							image
							FROM master_aplikasi
							WHERE status_data = true`

	// Membentuk klausa filter berdasarkan input pengguna
	sFilter := ""
	if filter != "" {
		filter = "%" + strings.ToLower(filter) + "%"
		sFilter = ` AND (LOWER(nama_aplikasi) LIKE ? OR LOWER(deskripsi) LIKE ?)`
	}

	// Jika order tidak diset, gunakan default order
	if order == "" {
		order = "nama_aplikasi ASC"
	}

	// Query akhir
	query := fmt.Sprintf("%s %s ORDER BY %s LIMIT ? OFFSET ?", sTable, sFilter, order)

	// Menyimpan hasil query ke dalam apps
	var apps []map[string]interface{}

	// Eksekusi query dengan binding parameter untuk filter
	if filter != "" {
		database.DB.Raw(query, filter, filter, limitParam, offsetParam).Scan(&apps)
	} else {
		database.DB.Raw(query, limitParam, offsetParam).Scan(&apps)
	}

	// Mengisi response
	resp.Success = true
	resp.Message = "Success"
	resp.Data = apps

	return resp
}

// GetMasterApp retrieves a MasterApp by its ID
func GetMasterApp(id int) types.Response {
	var resp types.Response
	var app map[string]interface{}

	result := database.DB.Raw(`SELECT
								id_master_aplikasi,
								nama_aplikasi,
								deskripsi,
								versi_aplikasi,
								status_data,
								tgl_version,
								url,
								image
								FROM master_aplikasi WHERE id_master_aplikasi = ? AND status_data = true`, id).Scan(&app) // Menambahkan prefix ""
	if result.Error != nil {
		resp.Success = false
		resp.Message = "Failed to retrieve MasterApp"
		resp.Data = nil
		return resp
	} else if result.RowsAffected == 0 {
		resp.Success = false
		resp.Message = "MasterApp not found"
		resp.Data = nil
		return resp
	}

	resp.Success = true
	resp.Message = "Success"
	resp.Data = app

	return resp
}

// UpdateMasterApp updates a MasterApp by its ID
func UpdateMasterApp(id int, namaAplikasi, deskripsi, versiAplikasi, url, image string, statusData bool) types.Response {
	var resp types.Response

	result := database.DB.Exec(`UPDATE master_aplikasi
								SET nama_aplikasi = ?, deskripsi = ?, versi_aplikasi = ?, url = ?, image = ?, status_data = ?
								WHERE id_master_aplikasi = ?`, namaAplikasi, deskripsi, versiAplikasi, url, image, statusData, id) // Menambahkan prefix ""

	if result.Error != nil {
		resp.Success = false
		resp.Message = "Failed to update MasterApp"
		resp.Data = nil
		return resp
	} else if result.RowsAffected == 0 {
		resp.Success = false
		resp.Message = "MasterApp not found"
		resp.Data = nil
		return resp
	}

	resp.Success = true
	resp.Message = "Success"
	resp.Data = nil

	return resp
}

// DeleteMasterApp deletes a MasterApp by its ID
func DeleteMasterApp(id int) types.Response {
	var resp types.Response

	result := database.DB.Exec(`DELETE FROM master_aplikasi WHERE id_master_aplikasi = ?`, id) // Menambahkan prefix ""
	if result.Error != nil {
		resp.Success = false
		resp.Message = "Failed to delete MasterApp"
		resp.Data = nil
		return resp
	} else if result.RowsAffected == 0 {
		resp.Success = false
		resp.Message = "MasterApp not found"
		resp.Data = nil
		return resp
	}

	resp.Success = true
	resp.Message = "Success"
	resp.Data = nil

	return resp
}
